import pandas as pd
import numpy as np

df = pd.DataFrame({
    "date": pd.to_datetime([
        "2026-05-01",
        "2026-07-11",
        "2026-12-30"
    ])
})

df["day_of_year"] = df["date"].dt.dayofyear


df["day_sin"] = np.sin(
    2 * np.pi * df["day_of_year"] / 365
)

df["day_cos"] = np.cos(
    2 * np.pi * df["day_of_year"] / 365
)

