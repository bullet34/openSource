private bool value = false;

public UserControl1()
{
    InitializeComponent();
}

public bool Value
{
    get { return value; }
    set { this.value = value; Invalidate(); }
}

protected override void OnPaint(PaintEventArgs e)
{
    base.OnPaint(e);
    Graphics g = e.Graphics;
    g.SmoothingMode = SmoothingMode.AntiAlias;

    int margin = 5;
    Rectangle rect = new Rectangle(margin, margin, Width - margin * 2, Height - margin * 2);

    // Define colors for ON and OFF states (Center highlight and outer edge)
    Color centerColor, edgeColor;
    if (value == true)
    {
        centerColor = Color.LightGreen;
        edgeColor = Color.LimeGreen;
    }
    else
    {
        centerColor = Color.MediumSeaGreen;
        edgeColor = Color.DarkGreen;
    }

    // Create a circular path for the gradient
    using (GraphicsPath path = new GraphicsPath())
    {
        path.AddEllipse(rect);

        // Apply a radial path gradient for a 3D glowing sphere effect
        using (PathGradientBrush pgb = new PathGradientBrush(path))
        {
            pgb.CenterColor = centerColor;
            pgb.SurroundColors = new Color[] { edgeColor };
            // Shift the center slightly up/left for a shiny reflection look (optional)
            pgb.CenterPoint = new PointF(rect.X + rect.Width * 0.35f, rect.Y + rect.Height * 0.35f);

            g.FillPath(pgb, path);
        }
    }

    // Draw the outer border
    using (Pen pen = new Pen(Color.Black, 2))
    {
        g.DrawEllipse(pen, rect);
    }
}

