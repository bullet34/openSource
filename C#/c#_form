private void serialPort1_DataReceived(object sender, System.IO.Ports.SerialDataReceivedEventArgs e)
        {
            int receive_len = serialPort1.BytesToRead;

            byte[] buffer = new byte[receive_len];
            serialPort1.Read(buffer, 0, receive_len);

            receive_array.AddRange(buffer);

            int start = receive_array.IndexOf(0x06);
            int end = receive_array.IndexOf(0x03);

            if(start < 0)
            {
                receive_array.Clear();
                return;
            }
            if(start > 0)
            {
                receive_array.RemoveRange(start, end);
            }

            if(start == 0 && end != -1)
            {
                byte[] get_data = receive_array.GetRange(start, end + 1).ToArray();
                BeginInvoke(new Action(() =>
                {
                    string str = Encoding.ASCII.GetString(get_data);

                    if (str[3] == 'R')
                    {
                        textBox1.AppendText(str + Environment.NewLine); // 문자열 출력
                    }
                }));

                receive_array.RemoveRange(start, end + 1);
            }
        }

