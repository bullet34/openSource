private Bitmap SplitChannel(Bitmap src)
{
    int width = src.Width;
    int height = src.Height;

    Bitmap bmp8 = new Bitmap(width, height, PixelFormat.Format8bppIndexed);

    ColorPalette palette = bmp8.Palette;

    for (int i = 0; i < 256; i++)
    {
        palette.Entries[i] = Color.FromArgb(i, i, i);
    }

    bmp8.Palette = palette;

    Rectangle rect = new Rectangle(0, 0, width, height);
    BitmapData srcData = src.LockBits(rect, ImageLockMode.ReadOnly, PixelFormat.Format24bppRgb);
    BitmapData bmpData = bmp8.LockBits(rect, ImageLockMode.WriteOnly, PixelFormat.Format8bppIndexed);

    int srcStride = srcData.Stride;
    int rStride = bmpData.Stride;

    byte[] srcBuffer = new byte[srcStride * height];
    byte[] bmpBuffer = new byte[rStride * height];

    Marshal.Copy(srcData.Scan0, srcBuffer, 0, srcBuffer.Length);

    for (int y = 0; y < height; y++)
    {
        for (int x = 0; x < width; x++)
        {
            int srcIndex = y * srcStride + x * 3;

            // Format24bppRgb의 실제 메모리 순서는 B G R
            byte B = srcBuffer[srcIndex];
            byte G = srcBuffer[srcIndex + 1];
            byte R = srcBuffer[srcIndex + 2];

            bmpBuffer[y * rStride + x] = R;
            
        }
    }

    Marshal.Copy(bmpBuffer, 0, bmpData.Scan0, bmpBuffer.Length);

    src.UnlockBits(srcData);
    bmp8.UnlockBits(bmpData);

    return bmp8;
}


